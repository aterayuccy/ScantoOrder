PASSPORT_SECRET=replace-with-a-long-random-secret
MONGODB_URI=mongodb://localhost:27017/mernDB
PORT=8080
CLIENT_BASE_URL=http://localhost:3000
UPLOADS_DIR=

# local 適合本機展示；部署時可切換 cloudinary，避免重部署後圖片消失。
IMAGE_STORAGE_PROVIDER=local
CLOUDINARY_URL=
# CLOUDINARY_URL 與以下三個欄位擇一設定。
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=scan-to-order

# Optional in local development. Configure a Redis URL in production so
# failed-login counters are shared by every server instance.
REDIS_URL=
# memory：Redis 失效時暫時使用單機限制；reject：回傳 503，避免多機限制不一致。
REDIS_FAILURE_MODE=memory
LOGIN_ATTEMPT_LIMIT=5
IP_LOGIN_ATTEMPT_LIMIT=25
LOGIN_ATTEMPT_WINDOW_MS=900000

# QR guest accounts expire automatically. Allowed range: 1 to 168 hours.
QR_GUEST_TTL_HOURS=24

# Leave these blank to use the built-in LINE Pay demonstration flow.
# Set sandbox credentials to connect to the real LINE Pay Sandbox.
LINE_PAY_ENV=sandbox
LINE_PAY_API_VERSION=v4
LINE_PAY_CHANNEL_ID=
LINE_PAY_CHANNEL_SECRET=
